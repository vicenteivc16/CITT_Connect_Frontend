# ==============================================================================
# CITT CONNECT — VARIABLES DE ENTORNO OFICIALES
# Copia este archivo como .env.local para desarrollo o agrégalas en Vercel Dashboard
# ==============================================================================

# Supabase URL (Desde tu proyecto en https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Public Anon Key (Para cliente frontend con RLS activado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Supabase Service Role Key (OPCIONAL: Solo en entornos backend/Edge protegidos, NUNCA exponer al cliente)
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# URL base pública para redirecciones y generación de enlaces de credencial QR
NEXT_PUBLIC_SITE_URL=https://citt-connect.vercel.app
